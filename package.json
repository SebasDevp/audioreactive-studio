{
  "name": "audioreactive-studio",
  "version": "0.14.1",
  "private": true,
  "description": "SebasDevp audio-reactive visual performance instrument · stable living systems, spatial memory, generative tree growth and 24 performance-ready worlds",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:web": "vite build",
    "preview:web": "vite preview --host 0.0.0.0",
    "start": "electron ."
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "cross-env": "10.0.0",
    "electron": "44.4.1",
    "vite": "8.2.2",
    "wait-on": "8.0.3"
  },
  "type": "module"
}
