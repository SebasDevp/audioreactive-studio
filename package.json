{
  "name": "audioreactive-studio",
  "version": "0.7.0",
  "private": true,
  "description": "Desktop audio-reactive visual performance app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173/control.html && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "cross-env": "10.0.0",
    "electron": "44.4.1",
    "vite": "8.2.2",
    "wait-on": "8.0.3"
  },
  "type": "module"
}
